# Copy to server/.env for local overrides; the server loads it at boot and
# real environment variables win over it. Every value has a working default.

# Port the API listens on. The Vite dev server proxies /api here.
PORT=3001

# Interface to bind. Loopback by default: the API has no authentication.
# Set 0.0.0.0 only if you understand that anyone on the network can use it.
HOST=127.0.0.1

# Where the progress database is written. Relative paths are relative to server/.
DATA_DIR=data

# Comma-separated allowlist. Only used when the client is served from a
# different origin; in development Vite proxies, so it rarely matters.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173

# Serve client/dist from the API, putting both halves on one origin.
# Defaults to true when NODE_ENV=production.
SERVE_CLIENT=false
